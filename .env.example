# rapid-selector settings. Copy to .env and fill in. Never commit .env.
# Write values without quotes: everything after "=" is the value, exactly as written.

# --- Settings ---------------------------------------------------------------

# The host's LAN address. Published ports bind to it and nothing else.
# Give the host a fixed address (a DHCP reservation on the router).
RAPIDSELECTOR_LAN_ADDRESS=
GATEWAY_PORT=4000
CHAT_PORT=4010

# Where the secrets below come from: env (this file) or secrets-service.
SECRETS_SOURCE=env
# Only for SECRETS_SOURCE=secrets-service: the service, and a file holding its client token.
SECRETS_SERVICE_URL=http://home-assistant:8002
SECRETS_SERVICE_TOKEN_FILE=

# --- Secrets ----------------------------------------------------------------
# With SECRETS_SOURCE=secrets-service, leave these empty and store them as fields
# of the secret "rapidselector" instead.

# Postgres password for LiteLLM's database. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# LiteLLM's master key (admin access). Generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Encrypts provider keys stored in the database. Generate: openssl rand -hex 32
# NEVER change it after the first start: stored provider keys would become unreadable.
LITELLM_SALT_KEY=
# Password for LiteLLM's admin UI (user "admin"). Generate: openssl rand -hex 16
LITELLM_UI_PASSWORD=
# The OpenRouter inference key for the gateway, created in OpenRouter's dashboard.
RAPIDSELECTOR_OPENROUTER_KEY=
# Open WebUI's session secret. Generate: openssl rand -hex 32
WEBUI_SECRET_KEY=
# Virtual keys, registered by scripts/setup-keys.sh. Generate each: echo "sk-$(openssl rand -hex 24)"
KEY_CHAT=
KEY_NODE_RED=
KEY_SMOKE_TEST=
